# Local dev environment — copy to .env.local and fill in values
# Run with: make run-ai-local  (or see Makefile for docker run command)

MODULE_NAME=ai_interaction_module
MODULE_PORT=8005
LOG_LEVEL=DEBUG

# Worker count — 1 for local dev (avoids duplicate startup logs)
HYPERCORN_WORKERS=1

# AI Provider: 'ollama' (local) or 'waddleai' (proxy)
AI_PROVIDER=ollama

# Ollama — running on host machine (Linux needs --add-host=host.docker.internal:host-gateway)
OLLAMA_HOST=host.docker.internal
OLLAMA_PORT=11434
OLLAMA_MODEL=tinyllama

# WaddleAI — only needed when AI_PROVIDER=waddleai
# WADDLEAI_BASE_URL=http://waddleai-proxy:8000
# WADDLEAI_API_KEY=wa-your-key-here

# Router — stub URL for local testing (module still starts without it)
ROUTER_API_URL=http://localhost:8000
