# HTTP client (http transport's webhook/rest_api/graphql/grpc sub-types +
# overlay transport, SSRF-guarded). [http2] extra (pulls in `h2`) is
# mandatory, not decorative -- the `grpc` sub-type is a real HTTP/2 call
# (services/transports/http.py) and httpx only negotiates HTTP/2 when the
# client was constructed with http2=True, which requires `h2` importable.
httpx[http2]>=0.27.0,<0.28.0

# SMTP (email adapter) -- genuinely new dependency, not previously pinned
# anywhere in this repo; see this task's PR body for the one-line addition.
# >=5.1.2 mandatory: 3.0.x-4.x carry PYSEC-2026-2338/CVE-2026-55558, fixed in
# 5.1.2. Verified API-compatible across the 3.x->5.x jump for this adapter's
# usage: send()'s message/hostname/port/username/password/start_tls/timeout
# kwargs are unchanged, and every exception type this adapter catches
# (SMTPAuthenticationError/SMTPRecipientsRefused/SMTPConnectError/
# SMTPServerDisconnected/SMTPTimeoutError/SMTPException) is still exported
# with the same name -- see services/adapters/email.py's module docstring
# for the one real behavioral change (SMTPRecipientsRefused now takes a
# list[SMTPRecipientRefused], not a dict).
aiosmtplib>=5.1.2,<6.0.0

