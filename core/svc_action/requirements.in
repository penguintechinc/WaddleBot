# svc-action -- ACTION stage-runner dependencies.
# Versions mirror libs/flask_core/requirements.in where the same package is
# already pinned there (transitively installed via `pip install
# libs/flask_core` in the Dockerfile) -- listed explicitly here too since
# svc-action imports them directly (quart/httpx/redis/pydal), not just
# through flask_core's own internals.

# Core Framework
quart>=0.19.0
hypercorn>=0.16.0

# Database (flask_core.AsyncDAL wraps pydal directly)
pydal>=20240906.1,<20250101
psycopg2-binary>=2.9.9

# Valkey/Redis (process -> action queue)
redis>=5.0.1
hiredis>=2.3.2

# HTTP client -- svc-action's own shared httpx.AsyncClient (app.py's
# startup(), passed to every bundle entrypoint as its http_client kwarg).
# [http2] extra (pulls in `h2`) is mandatory, not decorative -- bundles/
# discord_send_action.py and any bundle using waddle_transports' `http`
# transport's `grpc` sub_type need real HTTP/2 negotiation, which httpx
# only does when the client was constructed with http2=True.
httpx[http2]>=0.27.0,<0.28.0

