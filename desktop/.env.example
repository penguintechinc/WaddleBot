# Waddlebot Desktop Configuration

# Hub base URL (default: https://waddles.app)
# For self-hosted or beta environments:
# HUB_BASE=https://waddlebot.example.com
HUB_BASE=https://waddles.app

# Frontend environment (passed to React build)
# VITE_API_URL will be set based on HUB_BASE
VITE_DESKTOP=1

# Logging level
RUST_LOG=waddlebot_desktop=debug,tauri=info
