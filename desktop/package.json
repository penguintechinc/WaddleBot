    "axios": "1.7.7",
    "socket.io-client": "4.8.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.1",
    "@types/node": "22.10.5",
    "@types/react": "18.3.21",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "8.18.0",
    "@typescript-eslint/parser": "8.18.0",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "8.57.1",
    "typescript": "5.7.3",
    "vite": "6.2.0",
